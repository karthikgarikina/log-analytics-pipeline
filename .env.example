INGESTOR_PORT=8000
INDEXER_PORT=8001
INGESTOR_URL=http://ingestor:8000/logs
INGESTOR_BATCH_URL=http://ingestor:8000/logs/batch
INDEXER_URL=http://indexer:8001
DATA_DIR=/app/data
REPORTS_DIR=/app/reports
BUFFER_WINDOW_SECONDS=10
BATCH_SIZE=500
INDEXER_POLL_SECONDS=1
LOG_RATE_PER_SECOND=5
LOG_JITTER_SECONDS=30
LOG_DUPLICATE_PROBABILITY=0.02
LOG_GENERATOR_TOTAL=0
SEEN_ID_CACHE_SIZE=200000
REPORT_HOUR_UTC=0
REPORT_MINUTE_UTC=5
RUN_REPORT_ON_START=true
